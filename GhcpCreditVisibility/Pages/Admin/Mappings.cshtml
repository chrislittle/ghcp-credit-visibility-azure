@page
@model GhcpCreditVisibility.Pages.Admin.MappingsModel
@{
    ViewData["Title"] = "Admin — Access & Settings";
}

<div class="gh-pagehead">
    <div>
        <h1>Admin — Access &amp; Settings</h1>
        <div class="sub">
            Entra owns <strong>who is in a group</strong> (membership). This console owns <strong>what that group or user can
            do here</strong>, across three independent roles: <strong>cost center access</strong> (see specific teams),
            <strong>Enterprise reader</strong> (see everything in an enterprise), and <strong>administrator</strong> (manage this
            console, no data access). A principal can be an Entra <strong>security group</strong> or an individual
            <strong>user</strong> — the latter covers the lone manager with no dedicated group. Roles combine: a principal may
            hold any number of cost centers and a reader grant at the same time. Changes take effect on next page load — no re-login.
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-success py-2">@Model.Message</div>
}
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger py-2">@Model.Error</div>
}

<!-- Organization settings -->
<div class="gh-card">
    @* "Organization" here is this APP's display name, not a GitHub organization — the two now appear
       on adjacent screens (Reports has an Organization breakdown), so the hint says which is which. *@
    <div class="ch"><h2>Organization</h2><span class="hint">your company name for the header &amp; page title — not a GitHub organization</span></div>
    <div class="gh-cardbody">
        <form method="post" asp-page-handler="SaveSettings" class="row g-2 align-items-end">
            <div class="col-md-6">
                <label class="form-label mb-0 gh-note">Organization display name</label>
                <input name="orgDisplayName" class="form-control form-control-sm" value="@Model.OrgDisplayName" placeholder="e.g. Contoso Enterprise" />
            </div>
            <div class="col-md-2">
                <button class="btn btn-sm btn-primary w-100" type="submit">Save</button>
            </div>
        </form>
    </div>
</div>

<!-- Enterprise registry -->
<div class="gh-card">
    <div class="ch">
        <h2>GitHub enterprises</h2>
        <span class="hint">registry — snapshots run per enabled enterprise; no redeploy to add one</span>
    </div>
    <table>
        <thead><tr><th>Slug</th><th>Display name</th><th>Data source</th><th>PAT secret</th><th>PAT status</th><th>Last snapshot</th><th>History</th><th>Status</th><th></th></tr></thead>
        <tbody>
            @foreach (var row in Model.Enterprises)
            {
                var e = row.Enterprise;
                @* The panel below the table acts on ONE row, but nothing in the table said which —
                   with several enterprises registered, "Edit" and "History" opened a form whose
                   subject you had to infer from the slug in its heading. *@
                var isTarget = Model.EditEnterprise == e.Id || Model.BackfillEnterprise == e.Id;
                <tr style="@(isTarget ? "background:#fff8e5;box-shadow:inset 3px 0 0 #d9822b;" : "")">
                    <td><code>@e.Slug</code></td>
                    <td>@(e.DisplayName ?? "—")</td>
                    <td>@(e.UseMockData ? "Mock (demo)" : "Live GitHub")</td>
                    <td>@if (e.UseMockData) { <span style="color:#66707d">n/a</span> } else { <code>@e.PatSecretName</code> }</td>
                    <td>
                        @if (row.PatResolved is null) { <span style="color:#66707d">n/a (mock)</span> }
                        else if (row.PatResolved == true) { <span class="badge text-bg-success">resolved</span> }
                        else { <span class="badge text-bg-danger">PAT missing</span> }
                    </td>
                    <td style="color:#66707d">
                        @if (row.LastRunUtc is DateTime lr)
                        {
                            @lr.ToString("yyyy-MM-dd HH:mm")<text> UTC</text>
                            @if (row.LastRunStatus == "failed") { <span class="badge text-bg-danger ms-1">failed</span> }
                            else if (row.LastRunRowsWritten == 0) { <span class="badge text-bg-warning ms-1">0 rows</span> }
                        }
                        else { <span>never</span> }
                    </td>
                    @* Per-user history is collected forward from the day this app started watching, so a
                       new enterprise has no past. This column says how far back the data goes and links
                       to the panel that offers to fetch more — GitHub keeps 24 months, but AI credits
                       only exist from June 2026, so there is a real floor on what "more" can mean. *@
                    @* Offered for mock enterprises too: the mock honors the same epoch and serves the
                       same past months, so the demo exercises the real path rather than hiding it. *@
                    <td style="white-space:nowrap">
                        @if (e.UserBackfillEnabled) { <a href="?BackfillEnterprise=@e.Id"><span class="badge text-bg-info">backfilling…</span></a> }
                        else if (e.UserBackfillOldestYear is int hy && e.UserBackfillOldestMonth is int hm)
                        {
                            <a href="?BackfillEnterprise=@e.Id" style="color:#66707d" title="Per-user history collected back to this month.">
                                since @(new DateTime(hy, hm, 1).ToString("MMM yyyy"))
                            </a>
                        }
                        else { <a href="?BackfillEnterprise=@e.Id" title="Only usage collected since this app started watching. Click to see what history can still be fetched.">forward only</a> }
                    </td>
                    <td>
                        @if (e.Enabled) { <span class="badge text-bg-success">enabled</span> }
                        else { <span class="badge text-bg-secondary">disabled</span> }
                    </td>
                    <td style="text-align:right;white-space:nowrap">
                        @* Without this the only way to force a snapshot was restarting the container —
                           the scheduled job is an in-process 12-hour timer with no manual trigger. It
                           takes the same distributed lease, so it cannot collide with a scheduled run. *@
                        @if (e.Enabled)
                        {
                            <form method="post" asp-page-handler="RunSnapshot" style="display:inline">
                                <input type="hidden" name="id" value="@e.Id" />
                                <button class="btn btn-sm btn-outline-primary" type="submit"
                                        title="Snapshot this enterprise now instead of waiting for the 12-hour cycle. Runs in the background; refresh in a few seconds. Skipped (not queued) if another run is already in progress.">
                                    ▶ Run now
                                </button>
                            </form>
                        }
                        <a class="btn btn-sm btn-outline-secondary" href="?EditEnterprise=@e.Id">Edit</a>
                        <form method="post" asp-page-handler="SetEnterpriseEnabled" style="display:inline">
                            <input type="hidden" name="id" value="@e.Id" />
                            <input type="hidden" name="enabled" value="@((!e.Enabled).ToString())" />
                            <button class="btn btn-sm btn-outline-secondary" type="submit">@(e.Enabled ? "Disable" : "Enable")</button>
                        </form>
                        <form method="post" asp-page-handler="DeleteEnterprise" style="display:inline" class="js-confirm"
                              data-confirm="Remove enterprise @e.Slug AND PURGE ALL OF ITS DATA (usage history, budgets, mappings)? Purged history cannot be re-fetched from GitHub.">
                            <input type="hidden" name="id" value="@e.Id" />
                            <button class="btn btn-sm btn-outline-danger" type="submit">Remove…</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div class="gh-cardbody" style="border-top:1px solid var(--gh-line);background:#fafbff;">
        @if (Model.Backfill is { } bf)
        {
            var ent = bf.Enterprise;
            <div class="d-flex justify-content-between align-items-start">
                <h3 class="h6 mb-1">Fetch older history — <code>@ent.Slug</code></h3>
                <a class="btn btn-sm btn-outline-secondary" href="?">Close</a>
            </div>
            <p class="gh-note">
                Per-user usage is normally collected forward from the day this app started watching.
                GitHub will also serve <strong>past</strong> months — but one request per user per month,
                which is why this is off by default and why the cost is shown before you start it.
            </p>

            @if (ent.LicensedUserCount is null)
            {
                <div class="alert alert-warning py-2 mb-0">
                    No snapshot has run for <code>@ent.Slug</code> yet, so there is no user count to estimate with.
                    Run a snapshot first, then come back — the estimate will be exact rather than a guess.
                </div>
            }
            else if (!bf.HasWork)
            {
                <div class="alert alert-success py-2 mb-0">
                    Nothing left to fetch. History goes back as far as it can:
                    AI credits began <strong>1 June 2026</strong>, GitHub serves 24 months, and this app keeps
                    @Model.RetentionMonths months — whichever of those is most recent is the floor, and you are at it.
                </div>
            }
            else
            {
                <table class="mb-2" style="width:auto">
                    <tbody>
                        <tr><td class="gh-note pe-3">Months to fetch</td><td><strong>@bf.Months.Count</strong>
                            @if (bf.Oldest is { } o) { <span class="gh-note">(back to @(new DateTime(o.Year, o.Month, 1).ToString("MMMM yyyy")))</span> }
                        </td></tr>
                        <tr><td class="gh-note pe-3">Licensed users</td><td><strong>@bf.LicensedUsers</strong> <span class="gh-note">(from the last snapshot)</span></td></tr>
                        <tr><td class="gh-note pe-3">GitHub requests</td><td><strong>@bf.EstimatedCalls.ToString("N0")</strong>
                            <span class="gh-note">
                                @if (bf.FitsInOneRun) { <text>— fits inside one hour's rate limit, so it should finish in a single run.</text> }
                                else { <text>— more than one hour's rate limit allows, so it fills a few months per run and continues on later runs. That is expected, not a failure.</text> }
                            </span>
                        </td></tr>
                    </tbody>
                </table>
                <p class="gh-note">
                    It fills <strong>whole months, newest first</strong>, and only records a month once every user in it
                    is done — so the dashboard never shows a half-collected month that looks like a usage drop.
                    Backfilled months carry no day-level detail (that would cost 30× the requests); they appear at
                    month granularity. Stopping keeps everything already collected.
                </p>

                @if (ent.UserBackfillEnabled)
                {
                    <form method="post" asp-page-handler="CancelBackfill" style="display:inline">
                        <input type="hidden" name="id" value="@ent.Id" />
                        <span class="badge text-bg-info me-2">running</span>
                        <button class="btn btn-sm btn-outline-danger" type="submit">Stop backfill</button>
                    </form>
                    @* Only reachable when a run ended early — it stands itself down the moment the
                       plan is exhausted, so a still-enabled backfill has months left to fetch. *@
                    <span class="gh-note ms-2">
                        Paused with months still to fetch (usually the hourly rate limit). It resumes on the next
                        snapshot, or press <strong>▶ Run now</strong> above to continue immediately.
                    </span>
                }
                else
                {
                    <form method="post" asp-page-handler="StartBackfill" style="display:inline">
                        <input type="hidden" name="id" value="@ent.Id" />
                        <button class="btn btn-sm btn-primary" type="submit" @(ent.Enabled ? "" : "disabled")>Start backfill</button>
                    </form>
                    @if (!ent.Enabled) { <span class="gh-note ms-2" style="color:#d9822b">Enable this enterprise first — backfill runs as part of its snapshot.</span> }
                }
            }
        }
        else if (Model.EditingEnterprise is { } editing)
        {
            @* Titled like the backfill panel above it. This slot hosts three different forms that
               look nearly identical once rendered — without a heading, clicking Edit only fills the
               add-enterprise fields in, and there is nothing on screen saying the page changed mode
               or which enterprise it changed mode FOR. *@
            <div class="d-flex justify-content-between align-items-start mb-2">
                <h3 class="h6 mb-0">Edit enterprise — <code>@editing.Slug</code></h3>
                <a class="btn btn-sm btn-outline-secondary" href="?">Cancel</a>
            </div>
            <form method="post" asp-page-handler="UpdateEnterprise" class="row g-2 align-items-end">
                <input type="hidden" name="id" value="@editing.Id" />
                <div class="col-md-2">
                    <label class="form-label mb-0 gh-note">Slug (API)</label>
                    <input name="slug" class="form-control form-control-sm" value="@editing.Slug" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label mb-0 gh-note">Display name</label>
                    <input name="displayName" class="form-control form-control-sm" value="@editing.DisplayName" />
                </div>
                <div class="col-md-3">
                    <label class="form-label mb-0 gh-note">PAT secret name (Key Vault)</label>
                    <input name="patSecretName" class="form-control form-control-sm" value="@editing.PatSecretName" />
                </div>
                <div class="col-md-2">
                    <label class="form-label mb-0 gh-note">Data source</label>
                    <select name="useMockData" class="form-select form-select-sm">
                        <option value="false" selected="@(!editing.UseMockData)">Live GitHub</option>
                        <option value="true" selected="@(editing.UseMockData)">Mock (demo)</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-sm btn-primary w-100" type="submit">Save</button>
                </div>
            </form>
            <div class="gh-note mt-2">
                Changing the slug or data source changes what the <em>next</em> snapshot
                ingests — existing history stays attached to this enterprise either way. Switching Live → Mock (or renaming the
                slug of a mock enterprise) can mix differently-shaped current-month data until retention ages it out.
            </div>
        }
        else
        {
        <h3 class="h6 mb-2">Add an enterprise</h3>
        <form method="post" asp-page-handler="AddEnterprise" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label mb-0 gh-note">Slug (API)</label>
                <input name="slug" class="form-control form-control-sm" placeholder="my-enterprise" required />
            </div>
            <div class="col-md-3">
                <label class="form-label mb-0 gh-note">Display name</label>
                <input name="displayName" class="form-control form-control-sm" placeholder="Contoso" />
            </div>
            <div class="col-md-3">
                <label class="form-label mb-0 gh-note">PAT secret name (Key Vault)</label>
                <input name="patSecretName" class="form-control form-control-sm" placeholder="github-pat-&lt;slug&gt; (default)" />
            </div>
            <div class="col-md-2">
                <label class="form-label mb-0 gh-note">Data source</label>
                @* The hint that used to sit here pushed this column's inputs out of line with the
                   other four, because it is inside the align-items-end row. It lives below the form
                   now, where it says the same thing without bending the layout. *@
                <select name="useMockData" class="form-select form-select-sm">
                    <option value="false">Live GitHub</option>
                    <option value="true">Mock (demo)</option>
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-sm btn-primary w-100" type="submit">Add enterprise</button>
            </div>
        </form>
        <div class="gh-note mt-2">
            <span style="color:#d9822b">Live needs a PAT seeded before it can snapshot; Mock needs none.</span>
            New enterprises start <strong>disabled</strong>: seed the PAT out-of-band
            (<code>./deploy.ps1 -Task set-pat -Enterprise &lt;slug&gt;</code> — the PAT value is never entered in this console),
            wait for "PAT status: resolved", <strong>Enable</strong>, verify the first snapshot above, then map principals below.
            Nobody sees an enterprise's data until mappings exist. The snapshot job re-reads this registry every cycle — no restart.
            Mock enterprises named <code>contoso</code> / <code>fabrikam</code> come with demo data; the mock slug
            <code>demo-broken</code> always fails — register it to fire-drill the per-enterprise alerts safely.
        </div>
        }
    </div>
</div>

<!-- Principal -> Cost Center mappings -->
<div class="gh-card">
    <div class="ch">
        <h2>Cost center access</h2>
        <span class="hint">group or user — see only the cost centers mapped here</span>
    </div>
    <div class="gh-cardbody" style="border-bottom:1px solid var(--gh-line);">
        <p class="gh-note mb-0">
            <strong>Three roles, granted independently</strong> — this card and the two below it:
        </p>
        <ul class="gh-note mb-0" style="margin-top:6px;padding-left:18px;">
            <li><strong>Cost center access</strong> (here) — sees usage, budgets and reports for the cost centers
                mapped to it, and nothing else. The narrowest grant, and the only one that delegates a <em>part</em>
                of an enterprise.</li>
            <li><strong>Enterprise reader</strong> — sees <em>everything</em> within the enterprises granted, including
                the views below that cannot be narrowed to a cost center. No access to this console.</li>
            <li><strong>Administrator</strong> — manages this console. Grants <em>no</em> data access on its own.</li>
        </ul>
        <p class="gh-note mb-0" style="margin-top:8px;">
            ⚠️ <strong>GitHub organization views cannot be delegated to a cost center.</strong> The Reports
            <em>Organization</em> breakdown, <em>organization-scoped budgets</em> and the <em>allowance pool</em> need the
            <strong>Enterprise reader</strong> role. GitHub's organization usage report carries no cost center, so there is
            nothing to narrow it by — granting it to a cost-center principal would expose every other team's spend in
            that enterprise. If a manager reports they cannot see an organization breakdown, that is working as intended:
            grant them Enterprise reader for that enterprise. <strong>Do not make them an administrator</strong> — that
            grants console access without granting the visibility they actually asked for.
        </p>
    </div>
    <table>
        <thead><tr><th>Type</th><th>Principal</th><th>Object ID</th><th>Cost centers</th><th>Last updated</th><th></th></tr></thead>
        <tbody>
            @{
                // Group rows by principal so it's obvious at a glance that one group/user can see
                // MULTIPLE cost centers (e.g. an exec who needs a top-down, cross-cost-center view).
                var grouped = Model.Mappings
                    .GroupBy(m => (m.PrincipalType, m.PrincipalObjectId))
                    .OrderBy(g => g.First().PrincipalDisplayName ?? g.Key.PrincipalObjectId);
            }
            @foreach (var g in grouped)
            {
                var first = g.First();
                <tr>
                    <td>@(first.PrincipalType == "User" ? "👤 User" : "👥 Group")</td>
                    <td>@(first.PrincipalDisplayName ?? "—")</td>
                    <td style="color:#66707d"><code>@first.PrincipalObjectId</code></td>
                    <td>
                        @foreach (var m in g.OrderBy(x => x.EnterpriseId).ThenBy(x => x.CostCenterName ?? x.CostCenterId))
                        {
                            <span class="badge rounded-pill text-bg-light border me-1 mb-1" style="font-weight:500;">
                                @(m.CostCenterName ?? m.CostCenterId)@if (Model.MultiEnterprise) {<span style="color:#66707d;font-weight:400"> · @(Model.EnterpriseNames.TryGetValue(m.EnterpriseId, out var en) ? en : $"enterprise {m.EnterpriseId}")</span>}
                                @* Confirmation text goes in a data-* attribute, NOT inline JS: these values carry
                                   GitHub cost-center names and operator-supplied labels, and Razor's HTML encoding
                                   does not survive the browser decoding an attribute before parsing it as script.
                                   site.js reads data-confirm as text — see the js-confirm handler there. *@
                                <form method="post" asp-page-handler="DeleteMapping" style="display:inline" class="js-confirm"
                                      data-confirm="Remove access to @(m.CostCenterName ?? m.CostCenterId) for @(first.PrincipalDisplayName ?? first.PrincipalObjectId)?">
                                    <input type="hidden" name="id" value="@m.Id" />
                                    <button type="submit" class="btn btn-sm p-0 border-0" style="color:#d1242f;background:none;line-height:1;" title="Remove this cost center">&times;</button>
                                </form>
                            </span>
                        }
                    </td>
                    <td style="color:#66707d">@g.Max(x => x.UpdatedUtc).ToString("yyyy-MM-dd")</td>
                    <td></td>
                </tr>
            }
            @if (Model.Mappings.Count == 0)
            {
                <tr><td colspan="6" style="text-align:center;color:#66707d;padding:22px 0;">No mappings yet. Add one below.</td></tr>
            }
        </tbody>
    </table>
    <div class="gh-cardbody" style="border-top:1px solid var(--gh-line);background:#fafbff;">
        <form method="post" asp-page-handler="AddMapping" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label mb-0 gh-note">Type</label>
                <select name="principalType" class="form-select form-select-sm">
                    <option value="Group">👥 Group</option>
                    <option value="User">👤 User</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label mb-0 gh-note">Object ID</label>
                <input name="principalObjectId" class="form-control form-control-sm" placeholder="00000000-0000-0000-0000-000000000000" required />
            </div>
            <div class="col-md-3">
                <label class="form-label mb-0 gh-note">Name (label)</label>
                <input name="principalName" class="form-control form-control-sm" placeholder="SG-Finance / Dana Manager" />
            </div>
            <div class="col-md-2">
                <label class="form-label mb-0 gh-note">Cost center(s)</label>
                <select name="costCenterKeys" class="form-select form-select-sm" multiple size="4" required>
                    @foreach (var entGroup in Model.CostCenters.GroupBy(c => new { c.EnterpriseId, c.EnterpriseName }))
                    {
                        <optgroup label="@(entGroup.Key.EnterpriseName ?? $"enterprise {entGroup.Key.EnterpriseId}")">
                            @foreach (var c in entGroup)
                            {
                                <option value="@c.Key">@(c.Name ?? c.Id)</option>
                            }
                        </optgroup>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-sm btn-primary w-100" type="submit">Add mapping</button>
            </div>
        </form>
        @if (Model.CostCenters.Count == 0)
        {
            <div class="gh-note mt-2" style="color:#d9822b">No cost centers discovered yet — the snapshot job must run at least once (mock data seeds on startup).</div>
        }
        <div class="gh-note mt-2">
            Use <strong>User</strong> for an individual (e.g. a single manager who should see one cost center and has no dedicated group).
            <strong>Ctrl/Cmd-click</strong> (or shift-click for a range) to select several cost centers at once — a group or user
            can be granted <strong>any number</strong> of cost centers, so an exec can get a single top-down view across the whole org.
            Remove one cost center at a time with the <strong>&times;</strong> on its badge above.
        </div>
    </div>
</div>

<!-- Enterprise readers -->
<div class="gh-card">
    <div class="ch"><h2>Enterprise readers</h2><span class="hint">group or user — see everything in an enterprise (no console access)</span></div>
    <table>
        <thead><tr><th>Type</th><th>Principal</th><th>Object ID</th><th>Enterprise</th><th></th></tr></thead>
        <tbody>
            @foreach (var g in Model.ReaderGrants)
            {
                <tr>
                    <td>@(g.PrincipalType == "User" ? "👤 User" : "👥 Group")</td>
                    <td>@(g.PrincipalDisplayName ?? "—")</td>
                    <td style="color:#66707d"><code>@g.PrincipalObjectId</code></td>
                    <td>
                        @if (g.EnterpriseId is long gid)
                        {
                            <text>🏢 @Model.EnterpriseNames.GetValueOrDefault(gid, $"enterprise {gid}")</text>
                        }
                        else
                        {
                            @* Deliberately distinct styling: an all-enterprises grant automatically
                               covers enterprises registered in future, which a reader of this table
                               must not have to infer. *@
                            <span class="gh-badge ok" title="Covers every enterprise, including any registered later.">All enterprises</span>
                        }
                    </td>
                    <td style="text-align:right">
                        <form method="post" asp-page-handler="DeleteReader" class="js-confirm" data-confirm="Remove this reader grant?">
                            <input type="hidden" name="id" value="@g.Id" />
                            <button class="btn btn-sm btn-outline-danger" type="submit">Remove</button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.ReaderGrants.Count == 0)
            {
                <tr><td colspan="5" style="text-align:center;color:#66707d;padding:22px 0;">No Enterprise Reader grants. (The Entra "Admin" app role still sees all data as a bootstrap.)</td></tr>
            }
        </tbody>
    </table>
    <div class="gh-cardbody" style="border-top:1px solid var(--gh-line);background:#fafbff;">
        <form method="post" asp-page-handler="AddReader" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label mb-0 gh-note">Type</label>
                <select name="principalType" class="form-select form-select-sm">
                    <option value="Group">👥 Group</option>
                    <option value="User">👤 User</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label mb-0 gh-note">Object ID</label>
                <input name="principalObjectId" class="form-control form-control-sm" placeholder="00000000-0000-0000-0000-000000000000" required />
            </div>
            <div class="col-md-2">
                <label class="form-label mb-0 gh-note">Name (label)</label>
                <input name="principalName" class="form-control form-control-sm" placeholder="SG-GHCP-Finance" />
            </div>
            <div class="col-md-3">
                <label class="form-label mb-0 gh-note">Enterprise</label>
                <select name="enterpriseId" class="form-select form-select-sm">
                    <option value="">All enterprises</option>
                    @foreach (var kv in Model.EnterpriseNames.OrderBy(k => k.Value))
                    {
                        <option value="@kv.Key">@kv.Value</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-sm btn-primary w-100" type="submit">Grant reader</button>
            </div>
        </form>
        <div class="gh-note mt-2">
            An <strong>Enterprise Reader</strong> sees every cost center's spend, the organization breakdown and
            enterprise-wide budgets — but <strong>only for the enterprises granted</strong>, and with no access to this console.
            This is the role for finance and reporting users; it exists so they need not be made administrators.
            Granting <strong>All enterprises</strong> replaces any per-enterprise grants that principal already had.
        </div>
    </div>
</div>

<!-- Admin principals -->
<div class="gh-card">
    @* Administrators manage this console and NOTHING ELSE. Seeing data is a separate grant — see
       the Enterprise readers card below. The hint used to say "see all data + manage this console",
       which is what forced report consumers to be made administrators. *@
    <div class="ch"><h2>Administrators</h2><span class="hint">group or user — manage this console (no data access)</span></div>
    <table>
        <thead><tr><th>Type</th><th>Principal</th><th>Object ID</th><th></th></tr></thead>
        <tbody>
            @foreach (var a in Model.AdminPrincipals)
            {
                <tr>
                    <td>@(a.PrincipalType == "User" ? "👤 User" : "👥 Group")</td>
                    <td>@(a.PrincipalDisplayName ?? "—")</td>
                    <td style="color:#66707d"><code>@a.PrincipalObjectId</code></td>
                    <td style="text-align:right">
                        <form method="post" asp-page-handler="DeleteAdmin" class="js-confirm" data-confirm="Remove this administrator?">
                            <input type="hidden" name="id" value="@a.Id" />
                            <button class="btn btn-sm btn-outline-danger" type="submit">Remove</button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.AdminPrincipals.Count == 0)
            {
                <tr><td colspan="4" style="text-align:center;color:#66707d;padding:22px 0;">No admin principals. (The Entra "Admin" app role also grants admin.)</td></tr>
            }
        </tbody>
    </table>
    <div class="gh-cardbody" style="border-top:1px solid var(--gh-line);background:#fafbff;">
        <form method="post" asp-page-handler="AddAdmin" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label mb-0 gh-note">Type</label>
                <select name="principalType" class="form-select form-select-sm">
                    <option value="Group">👥 Group</option>
                    <option value="User">👤 User</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label mb-0 gh-note">Object ID</label>
                <input name="principalObjectId" class="form-control form-control-sm" placeholder="00000000-0000-0000-0000-000000000000" required />
            </div>
            <div class="col-md-3">
                <label class="form-label mb-0 gh-note">Name (label)</label>
                <input name="principalName" class="form-control form-control-sm" placeholder="SG-GHCP-Admins" />
            </div>
            <div class="col-md-3">
                <button class="btn btn-sm btn-primary w-100" type="submit">Add administrator</button>
            </div>
        </form>
    </div>
</div>

<!-- Budgets (governed in GitHub) -->
<div class="gh-card">
    <div class="ch"><h2>Budgets</h2><span class="hint">governed in GitHub — read-only here</span></div>
    <div class="gh-cardbody">
        <p class="mb-2">
            Budgets are <strong>configured and enforced in GitHub</strong> (enterprise / organization / cost-center budgets),
            and GitHub sends the budget <strong>alert emails</strong>. This app does not create or edit budgets — the snapshot job
            reads them from GitHub and the <a asp-page="/Index">Usage</a> dashboard shows each budget's current-month utilization.
        </p>
        <p class="gh-note mb-0">
            Manage budgets in GitHub:
            <a href="https://docs.github.com/en/enterprise-cloud@@latest/billing/concepts/budgets-and-alerts" target="_blank" rel="noopener">Budgets &amp; alerts ↗</a> ·
            <a href="https://docs.github.com/en/copilot/concepts/billing/budgets-for-usage-based-billing" target="_blank" rel="noopener">Copilot usage-based budgets ↗</a>
        </p>
    </div>
</div>

<!-- Helper: your own identifiers -->
<div class="gh-card">
    <div class="ch"><h2>Your identifiers</h2><span class="hint">from your sign-in token — handy for adding yourself</span></div>
        <div class="gh-cardbody">
        <div class="mb-2">👤 <strong>Your user object ID:</strong> @if (string.IsNullOrEmpty(Model.MyUserObjectId)) { <span style="color:#66707d">not present in token</span> } else { <code>@Model.MyUserObjectId</code> }</div>
        👥 <strong>Your group object IDs:</strong>
        @if (Model.MyGroups.Count == 0)
        {
            <span style="color:#66707d">none in token (you may hold the Entra "Admin" app role, or your groups exceed the token limit).</span>
        }
        else
        {
            @foreach (var g in Model.MyGroups)
            {
                <div><code>@g</code></div>
            }
        }
    </div>
</div>

<!-- Runtime configuration (admin-only) -->
<div class="gh-card">
    <div class="ch"><h2>Configuration</h2><span class="hint">current runtime settings (read-only)</span></div>
    <table>
        <tbody>
            <tr><td><strong>Organization display name</strong></td><td>@(string.IsNullOrWhiteSpace(Model.OrgDisplayName) ? "— not set — (set it above)" : Model.OrgDisplayName)</td></tr>
            <tr><td><strong>Default data source</strong></td><td>@(Model.UseMock ? "Mock data (demo — no GitHub token required)" : "Live GitHub billing API") <span style="color:#98a2b3">(per-enterprise override in the registry above)</span></td></tr>
            <tr><td><strong>GitHub enterprises</strong></td><td>@Model.Enterprises.Count registered (@Model.Enterprises.Count(e => e.Enterprise.Enabled) enabled) — managed in the registry above</td></tr>
            <tr><td><strong>Access model</strong></td><td>@Model.ScopingStrategyLabel <span style="color:#98a2b3">(<code>@Model.ScopingStrategy</code>)</span></td></tr>
            <tr><td><strong>History retained</strong></td><td>@Model.RetentionMonths months</td></tr>
            <tr><td><strong>Persistence</strong></td><td>@(Model.UsingSqlServer ? "Azure SQL (managed identity)" : "In-memory (local preview)")</td></tr>
            <tr><td><strong>App version</strong></td><td>v@(GhcpCreditVisibility.AppInfo.Version)</td></tr>
        </tbody>
    </table>
    <div class="gh-cardbody">
        <div class="gh-note mb-0">
            These are set at deploy time (<code>appsettings.json</code> / Terraform) except the organization name (edited above).
            Data source switches to the live GitHub API when <code>GitHub:UseMock=false</code> and a token is provided.
        </div>
    </div>
</div>
